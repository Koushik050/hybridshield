# Copy this file to .env.local and fill in values.

# reCAPTCHA Enterprise site key for App Check (used by the hosted app).
VITE_RECAPTCHA_SITE_KEY=

# App Check debug token.
# - Leave empty on localhost: a new debug token is printed in the browser console;
#   register it in Firebase console > App Check > Apps > Manage debug tokens.
# - Or paste a registered debug token here to reuse it (e.g. for a hosted judging build).
VITE_APPCHECK_DEBUG_TOKEN=
